  @combat-to-combat   _ _ _ _   _ _       _       A-C-k   A-C-l   _       @ui-to-chat @combat-to-chat-ret
  @combat-to-world _ _ _   _ _ _       A-C-m   _ _ _   _
  _    _    _    _   @combat-to-leader _    _
)

(deflayer world
