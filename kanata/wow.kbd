;; GENERATED by layoutgen from layout.toml. Edit that, then `cargo run`.
;;
;; Emergency exit (winIOv2 default): hold Left Ctrl + Space + Esc.

(defcfg
  process-unmapped-keys yes
)

(defalias
  bn-chat A-C-S-f12
  bn-combat A-C-S-f9
  chat-to-combat-esc (multi (layer-switch combat) (macro esc @bn-combat))
  chat-to-combat-ret (multi (layer-switch combat) (macro ret @bn-combat))
  combat-to-chat-ret (multi (layer-switch chat) (macro @bn-chat ret))
  combat-to-combat (multi (layer-switch combat) (macro @bn-combat))
)

(defsrc
  esc
  grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  tab q w e r t y u i o p [ ] \
  caps                a s d f g h j k l ; ' ret
  lsft z x c v b n m , . / rsft
  lctl lmet lalt spc ralt rmet rctl
)

(deflayer combat
  _
  _   _ _ _ _ _ _ _ _ _ _ _ _ _
  _   _ _ _ _ _ _ _ _ _ _ _ _ _
  @combat-to-combat   _ _ _ _ _ _ _ _ _ _ _ @combat-to-chat-ret
  _    _ _ _ _ _ _ _ _ _ _ _
  _    _    _    _   _    _    _
)

(deflayer chat
  @chat-to-combat-esc
  _   _ _ _ _ _ _ _ _ _ _ _ _ _
  _   _ _ _ _ _ _ _ _ _ _ _ _ _
  @chat-to-combat-esc _ _ _ _ _ _ _ _ _ _ _ @chat-to-combat-ret
  _    _ _ _ _ _ _ _ _ _ _ _
  _    _    _    _   _    _    _
)
